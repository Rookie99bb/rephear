{
  "name": "rephear",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:phase1": "DATA_DIR=$(mktemp -d /tmp/rephear-phase1-test.XXXXXX) tsx scripts/phase1-privacy.test.ts",
    "test:homepage-cards": "DATA_DIR=$(mktemp -d /tmp/rephear-homepage-cards-test.XXXXXX) tsx scripts/homepage-category-cards.test.ts",
    "test:phase5-story": "DATA_DIR=$(mktemp -d /tmp/rephear-phase5-story-test.XXXXXX) tsx scripts/smoke-phase5-story.ts",
    "test:phase5": "DATA_DIR=$(mktemp -d /tmp/rephear-phase5-test.XXXXXX) tsx scripts/smoke-phase5-moments.ts",
    "test:phase2": "DATA_DIR=$(mktemp -d /tmp/rephear-phase2-test.XXXXXX) tsx scripts/smoke-phase2-identity.ts",
    "test:phase3": "DATA_DIR=$(mktemp -d /tmp/rephear-phase3-test.XXXXXX) tsx scripts/smoke-phase3-milestones.ts",
    "test:phase4": "DATA_DIR=$(mktemp -d /tmp/rephear-phase4-test.XXXXXX) tsx scripts/smoke-phase4-cards.ts",
    "test:curation": "DATA_DIR=$(mktemp -d /tmp/rephear-curation-test.XXXXXX) tsx scripts/curation.test.ts",
    "test:global-hero": "DATA_DIR=$(mktemp -d /tmp/rephear-hero-test.XXXXXX) tsx scripts/global-hero.test.ts",
    "test:phase5.5": "DATA_DIR=$(mktemp -d /tmp/rephear-phase5.5-test.XXXXXX) tsx scripts/smoke-phase5.5-thanks.ts",
    "test:phase5.6": "DATA_DIR=$(mktemp -d /tmp/rephear-phase5.6-test.XXXXXX) tsx scripts/smoke-phase5.6-cards.ts",
    "test:phase5.7": "DATA_DIR=$(mktemp -d /tmp/rephear-phase5.7-test.XXXXXX) tsx scripts/smoke-phase5.7-identity.ts",
    "test:event-space": "DATA_DIR=$(mktemp -d /tmp/rephear-event-test.XXXXXX) tsx scripts/event-social-space.test.ts",
    "test:welcome-email": "DATA_DIR=$(mktemp -d /tmp/rephear-welcome-email-test.XXXXXX) tsx scripts/welcome-email.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "framer-motion": "^11.15.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.17.2",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
